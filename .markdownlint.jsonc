// Правила markdownlint для документації Recall (Docs Quality Gate, ЛР7).
{
  "default": true,
  // Абзац пишеться одним рядком: так його переносять Obsidian і pandoc.
  "MD013": false,
  // Якорі вимог <a id="srs-…">, розриви рядків у клітинках таблиць і бейджі кореневого README.
  "MD033": { "allowed_elements": ["a", "br", "img", "p", "b"] },
  // Однакові підзаголовки дозволено в різних розділах (наприклад, «Context» у кожному ADR).
  "MD024": { "siblings_only": true },
  // Список джерел за ДСТУ 8302:2015 містить адреси у форматі «URL: https://…».
  "MD034": false,
  // Callout-блоки Obsidian, що йдуть поспіль, розділяються порожнім рядком.
  "MD028": false,
  // Ієрархія заголовків: один заголовок H1 на файл, рівні без пропусків.
  "MD025": true,
  "MD001": true,
  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" }
}
